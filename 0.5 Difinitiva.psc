Algoritmo Difinitiva
	Definir n1 ,n2 ,n3, n4,  nf Como Real
	Escribir "ingrse el valor nota1"
	Leer n1
	Escribir "ingrse el valor nota2"
	Leer n2
	Escribir "ingrse el valor nota3"
	Leer n3
	Escribir "ingrse el valor nota4"
	Leer n4
	nf = ( n1 + n2 + n3 + n4 ) / 4
	Escribir " la difinitva es ", nf 
FinAlgoritmo
